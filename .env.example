# Identidade e contato — preencher apenas no ambiente privado do operador.
LEGAL_NAME=
TAX_ID=
CONTACT_EMAIL=
CONTACT_PHONE=
FULL_ADDRESS=

# Checkout com Mercado Pago (backend privado; passo a passo em docs/mercadopago.md).
# PAYMENT_API_KEY é o access token de produção (APP_USR-...) da sua integração.
# PAYMENT_WEBHOOK_SECRET é a "assinatura secreta" mostrada no painel de webhooks.
PAYMENT_PROVIDER=mercadopago
PAYMENT_CHECKOUT_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Servidor de vendas (rtc-check-vendas), que emite a licença após o pagamento.
RTC_CHECK_VENDAS_URL=
RTC_CHECK_VENDAS_DIR=
RTC_CHECK_CHAVE_PRIVADA=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Nomes consumidos pelo aplicativo desktop. Somente a URL HTTPS é pública.
# Sem configurar, o app usa o checkout oficial do projeto:
# https://rtc-check-vendas.onrender.com (Mercado Pago).
RTC_CHECK_PAYMENT_PROVIDER=
RTC_CHECK_CHECKOUT_URL=
RTC_CHECK_CHECKOUT_ALLOWED_HOSTS=
